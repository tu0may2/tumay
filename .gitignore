*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Окружение
.env

# Рабочие файлы: выгрузки из АБС, отчёты брокера, оборотные ведомости.
# В репозитории им не место — там лицевые счета, суммы и контрагенты, а
# попавший в историю git файл остаётся в ней навсегда, даже если его потом
# удалить. Правило от случайности: достаточно положить ведомость в папку
# терминала и набрать `git add -A`.
#
# Если файл всё-таки нужен в репозитории (образец формата, тестовый набор) —
# добавьте его принудительно: git add -f путь/к/файлу
*.xlsx
*.xlsm
*.xls
*.csv
*.log

# Прочее
node_modules/
.DS_Store
